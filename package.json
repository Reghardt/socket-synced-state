{
  "name": "socket-synced-state",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:client-ssr": "pnpm --filter client-ssr dev",
    "dev:server": "pnpm --filter server dev",
    "build:sss-client": "pnpm run --filter @socket-synced-state/client build",
    "build:sss-server": "pnpm run --filter @socket-synced-state/server build",
    "build": "pnpm concurrently \"pnpm build:sss-client\" \"pnpm run build:sss-server\"",
    "dev": "pnpm concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev-ssr": "pnpm concurrently \"pnpm dev:server\" \"pnpm dev:client-ssr\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
